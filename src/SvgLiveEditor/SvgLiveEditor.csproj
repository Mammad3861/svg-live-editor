<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SvgLiveEditor</AssemblyName>
    <RootNamespace>SvgLiveEditor</RootNamespace>
    <Version>0.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SvgLiveEditor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\welcome.svg">
      <LogicalName>SvgLiveEditor.Samples.welcome.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\*.svg">
      <LogicalName>SvgLiveEditor.Templates.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Resource Include="Assets\SvgLiveEditor.ico" />
  </ItemGroup>
</Project>
