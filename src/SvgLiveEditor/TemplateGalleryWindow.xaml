<Window x:Class="SvgLiveEditor.TemplateGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New from Template"
        Icon="Assets/SvgLiveEditor.ico"
        Width="720"
        Height="510"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        AutomationProperties.Name="SVG Template Gallery">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Choose a template"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="#0F172A" />
      <TextBlock Margin="0,6,0,0"
                 Text="Templates open as detached, unsaved SVG documents. Press Enter to open or Escape to cancel."
                 TextWrapping="Wrap"
                 Foreground="#475569" />
    </StackPanel>

    <ListBox x:Name="TemplateList"
             Grid.Row="1"
             ItemsSource="{Binding}"
             SelectedIndex="0"
             BorderBrush="#CBD5E1"
             BorderThickness="1"
             Background="White"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="OnTemplateDoubleClick"
             AutomationProperties.Name="Available SVG templates">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="8,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Name}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
              <TextBlock Margin="0,3,12,0"
                         Text="{Binding Description}"
                         TextWrapping="Wrap"
                         Foreground="#475569" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding Category}"
                         FontWeight="SemiBold"
                         Foreground="#2563EB"
                         HorizontalAlignment="Right" />
              <TextBlock Margin="0,3,0,0"
                         Text="{Binding Dimensions}"
                         Foreground="#64748B"
                         HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right"
              Content="Cancel"
              MinWidth="92"
              IsCancel="True" />
      <Button DockPanel.Dock="Right"
              Content="Open Template"
              MinWidth="126"
              Margin="0,2,8,2"
              IsDefault="True"
              Click="OnOpenTemplateClick" />
    </DockPanel>
  </Grid>
</Window>
