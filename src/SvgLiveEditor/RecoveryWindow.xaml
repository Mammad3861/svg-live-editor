<Window x:Class="SvgLiveEditor.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Recovery"
        Icon="Assets/SvgLiveEditor.ico"
        Width="740"
        Height="470"
        MinWidth="580"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        AutomationProperties.Name="Document Recovery">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Recovered work is available"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="#0F172A" />
      <TextBlock Margin="0,6,0,0"
                 Text="Restore opens the selected snapshot in memory as Modified. It never overwrites the original file."
                 TextWrapping="Wrap"
                 Foreground="#475569" />
    </StackPanel>

    <ListBox x:Name="RecoveryList"
             Grid.Row="1"
             ItemsSource="{Binding}"
             SelectedIndex="0"
             BorderBrush="#CBD5E1"
             BorderThickness="1"
             Background="White"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="Recoverable documents">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Snapshot.DisplayName}" />
          <Setter Property="AutomationProperties.HelpText"
                  Value="Recovery snapshot. Restore opens it in memory without overwriting the original file." />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="8,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Snapshot.DisplayName}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
              <TextBlock Margin="0,3,12,0"
                         Text="{Binding Snapshot.OriginalPath, TargetNullValue=Untitled document}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Snapshot.OriginalPath}"
                         Foreground="#475569" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding Snapshot.SavedUtc, StringFormat={}{0:g}}"
                       VerticalAlignment="Center"
                       Foreground="#64748B" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right"
              Content="Skip"
              MinWidth="90"
              IsCancel="True"
              Click="OnSkipClick" />
      <Button DockPanel.Dock="Right"
              Content="Discard"
              MinWidth="90"
              Margin="0,2,8,2"
              Click="OnDiscardClick" />
      <Button DockPanel.Dock="Right"
              Content="Restore"
              MinWidth="100"
              Margin="0,2,8,2"
              IsDefault="True"
              Click="OnRestoreClick" />
    </DockPanel>
  </Grid>
</Window>
