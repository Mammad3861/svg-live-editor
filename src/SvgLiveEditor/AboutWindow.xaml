<Window x:Class="SvgLiveEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SvgLiveEditor"
        Icon="Assets/SvgLiveEditor.ico"
        Width="520"
        Height="360"
        MinWidth="460"
        MinHeight="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8FAFC">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{Binding Name}"
               FontSize="28"
               FontWeight="SemiBold"
               Foreground="#0F172A" />
    <TextBox Grid.Row="1"
             Margin="0,12,0,0"
             Text="{Binding Version}"
             IsReadOnly="True"
             BorderThickness="0"
             Background="Transparent"
             FontSize="16"
             FontWeight="SemiBold"
             Foreground="#0F172A"
             ToolTip="Application version" />
    <TextBlock Grid.Row="2"
               Margin="0,4,0,0"
               Text="{Binding Architecture}"
               Foreground="#475569" />
    <TextBlock Grid.Row="3"
               Margin="0,18,0,0"
               Text="{Binding Description}"
               TextWrapping="Wrap"
               Foreground="#334155" />
    <StackPanel Grid.Row="4" Margin="0,18,0,0">
      <TextBlock Text="Repository" FontWeight="SemiBold" Foreground="#0F172A" />
      <TextBox Margin="0,6,0,0"
               Text="{Binding RepositoryUrl}"
               IsReadOnly="True"
               TextWrapping="NoWrap"
               HorizontalScrollBarVisibility="Auto"
               ToolTip="Repository URL" />
    </StackPanel>
    <StackPanel Grid.Row="5"
                Margin="0,22,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="Copy version information"
              Padding="12,6"
              Margin="0,0,8,0"
              Click="OnCopyVersionInformationClick" />
      <Button Content="Close"
              Padding="18,6"
              IsDefault="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
