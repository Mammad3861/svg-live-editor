<Window x:Class="SvgLiveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding WindowTitle}"
        Icon="Assets/SvgLiveEditor.ico"
        Width="1280"
        Height="800"
        MinWidth="1020"
        MinHeight="560"
        AllowDrop="True"
        Background="#F8FAFC"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        Deactivated="OnWindowDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewDragEnter="OnWindowPreviewDragEnter"
        PreviewDragOver="OnWindowPreviewDragOver"
        PreviewDragLeave="OnWindowPreviewDragLeave"
        PreviewDrop="OnWindowDrop"
        QueryContinueDrag="OnWindowQueryContinueDrag">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>

  <Grid>
    <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top" Background="White">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="OnNewClick" />
        <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OnOpenClick" />
        <Separator />
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="OnSaveClick" />
        <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="OnSaveAsClick" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndoClick" />
        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedoClick" />
        <Separator />
        <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="OnFindClick" />
        <MenuItem Header="_Replace" InputGestureText="Ctrl+H" Click="OnReplaceClick" />
        <Separator />
        <MenuItem Header="Copy _Entire SVG Source"
                  InputGestureText="Ctrl+Alt+C"
                  Click="OnCopyEntireSourceClick"
                  AutomationProperties.Name="Copy Entire SVG Source" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="WordWrapMenuItem"
                  Header="_Word Wrap"
                  InputGestureText="Alt+Z; Ctrl+Alt+W"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="OnWordWrapClick" />
        <Separator />
        <MenuItem x:Name="ReopenLastDocumentMenuItem"
                  Header="_Reopen last document on startup"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="OnReopenLastDocumentClick" />
      </MenuItem>
      <MenuItem Header="_Preview">
        <MenuItem Header="_Refresh" Click="OnRefreshPreviewClick" />
        <Separator />
        <MenuItem Header="_Copy Preview as PNG"
                  InputGestureText="Ctrl+Shift+C"
                  IsEnabled="{Binding CanCopyPreviewAsPng}"
                  Click="OnCopyPreviewAsPngClick"
                  AutomationProperties.Name="Copy Preview as PNG" />
        <Separator />
        <MenuItem Header="Zoom _In" Click="OnZoomInClick" />
        <MenuItem Header="Zoom _Out" Click="OnZoomOutClick" />
        <MenuItem Header="_Reset Zoom" Click="OnResetZoomClick" />
        <MenuItem Header="_Fit to Preview" Click="OnFitPreviewClick" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About SvgLiveEditor" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top" Background="#F1F5F9" IsLocked="True">
      <ToolBar Background="Transparent" BorderThickness="0">
        <Button Content="New" ToolTip="New (Ctrl+N)" Click="OnNewClick" />
        <Button Content="Open" ToolTip="Open SVG or TXT (Ctrl+O)" Click="OnOpenClick" />
        <Button Content="Save" ToolTip="Save (Ctrl+S)" Click="OnSaveClick" />
        <Separator />
        <Button Content="Refresh Preview" ToolTip="Validate and refresh now" Click="OnRefreshPreviewClick" />
        <Separator />
        <Button Content="Copy Image"
                ToolTip="Copy the full valid SVG artwork as a transparent PNG (Ctrl+Shift+C)"
                AutomationProperties.Name="Copy Preview as PNG"
                IsEnabled="{Binding CanCopyPreviewAsPng}"
                Click="OnCopyPreviewAsPngClick" />
        <Button x:Name="DragImageButton"
                ToolTip="Drag the rendered PNG to another application"
                AutomationProperties.Name="Drag Image"
                IsEnabled="{Binding CanCopyPreviewAsPng}"
                PreviewMouseLeftButtonDown="OnDragImagePreviewMouseLeftButtonDown"
                PreviewMouseMove="OnDragImagePreviewMouseMove"
                PreviewMouseLeftButtonUp="OnDragImagePreviewMouseLeftButtonUp"
                LostMouseCapture="OnDragImageLostMouseCapture">
          <StackPanel Orientation="Horizontal">
            <Path Width="14"
                  Height="14"
                  Margin="0,0,5,0"
                  Stretch="Uniform"
                  Fill="#334155"
                  Data="M3,1 L11,1 L11,4 L9,4 L9,3 L5,3 L5,9 L9,9 L9,8 L11,8 L11,11 L3,11 Z M8,5 L12,5 L12,3 L15,6 L12,9 L12,7 L8,7 Z" />
            <TextBlock Text="Drag Image" />
          </StackPanel>
        </Button>
        <ToggleButton x:Name="PanModeButton"
                      Content="Pan"
                      ToolTip="Pan overflowing preview with left drag (H toggles, Escape exits)"
                      AutomationProperties.Name="Pan preview mode"
                      Click="OnPanModeClick" />
        <Separator />
        <Button Content="Zoom In" ToolTip="Increase artwork zoom" Click="OnZoomInClick" />
        <Button Content="Zoom Out" ToolTip="Decrease artwork zoom" Click="OnZoomOutClick" />
        <Button Content="Reset Zoom" ToolTip="Show artwork at 100%" Click="OnResetZoomClick" />
        <Button Content="Fit" ToolTip="Fit SVG to the preview area" Click="OnFitPreviewClick" />
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom" Background="#E2E8F0" MinHeight="28">
      <StatusBarItem>
        <TextBlock Text="{Binding CurrentFileName}" FontWeight="SemiBold" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding SaveStatus}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding OperationStatus}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding OperationStatus}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock>
          <Run Text="Ln " /><Run Text="{Binding LineNumber, Mode=OneWay}" /><Run Text=", Col " /><Run Text="{Binding ColumnNumber, Mode=OneWay}" />
        </TextBlock>
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalContentAlignment="Stretch">
        <TextBlock Text="{Binding ValidationStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValidationStatus}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#B91C1C" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSvgValid}" Value="True">
                  <Setter Property="Foreground" Value="#047857" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="220" MaxWidth="460" />
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="White"
              BorderBrush="#CBD5E1"
              BorderThickness="1"
              CornerRadius="6"
              AutomationProperties.Name="Document Inspector">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="150" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="180" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  Padding="12,8"
                  Background="#F1F5F9"
                  BorderBrush="#CBD5E1"
                  BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="Document Inspector"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
              <TextBlock Text="{Binding Inspector.StateMessage}"
                         Margin="8,0,0,0"
                         HorizontalAlignment="Right"
                         Foreground="#64748B"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Inspector.StateMessage}" />
            </DockPanel>
          </Border>

          <Grid Grid.Row="1">
            <TreeView x:Name="InspectorTree"
                      ItemsSource="{Binding Inspector.Roots}"
                      SelectedItemChanged="OnInspectorTreeSelectionChanged"
                      PreviewMouseLeftButtonDown="OnInspectorTreePreviewMouseLeftButtonDown"
                      PreviewKeyDown="OnInspectorTreePreviewKeyDown"
                      PreviewKeyUp="OnInspectorTreePreviewKeyUp"
                      LostKeyboardFocus="OnInspectorTreeLostKeyboardFocus"
                      BorderThickness="0"
                      Padding="4"
                      AutomationProperties.Name="SVG element tree">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                  <Setter Property="Padding" Value="2" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Label}" Foreground="#0F172A" />
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <Border Background="White" Padding="18">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Inspector.HasIndex}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Inspector.StateTitle}"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Foreground="#334155" />
                <TextBlock Text="{Binding Inspector.StateMessage}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#64748B" />
              </StackPanel>
            </Border>
          </Grid>

          <GridSplitter Grid.Row="2"
                        Height="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#CBD5E1"
                        ShowsPreview="True"
                        AutomationProperties.Name="Resize inspector sections" />

          <Border Grid.Row="3"
                  Padding="12,8"
                  Background="#F8FAFC"
                  BorderBrush="#CBD5E1"
                  BorderThickness="0,1,0,1">
            <DockPanel>
              <TextBlock Text="Properties"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
              <TextBlock Text="{Binding Inspector.SelectedElementSummary}"
                         Margin="8,0,0,0"
                         HorizontalAlignment="Right"
                         Foreground="#64748B"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Inspector.SelectedElementSummary}" />
            </DockPanel>
          </Border>

          <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
              <ItemsControl ItemsSource="{Binding Inspector.Properties}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="3,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="92" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,5,8,0"
                                   Text="{Binding Name}"
                                   Foreground="#334155"
                                   ToolTip="{Binding PresenceText}" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 MinHeight="28"
                                 Padding="5,3"
                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Tag="{Binding}"
                                 ToolTip="{Binding PresenceText}"
                                 LostKeyboardFocus="OnInspectorPropertyLostKeyboardFocus"
                                 KeyDown="OnInspectorPropertyKeyDown"
                                 AutomationProperties.Name="{Binding Name}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,3,0,0"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="#B91C1C" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border Background="White" Padding="18">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Inspector.HasSelection}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="Select an SVG element to inspect its supported attributes."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="#64748B" />
            </Border>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="7"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#CBD5E1"
                    ShowsPreview="True"
                    AutomationProperties.Name="Resize Document Inspector" />

      <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="12,8" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="Source" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
              <TextBlock Text="SVG / XML" HorizontalAlignment="Right" Foreground="#64748B" />
            </DockPanel>
          </Border>

          <Border x:Name="FindReplacePanel" Grid.Row="1" Visibility="Collapsed" Padding="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Close" Padding="8,2" MinHeight="24" Click="OnCloseFindClick" />
                <Button DockPanel.Dock="Right" Content="Next" Padding="8,2" MinHeight="24" Click="OnFindNextClick" />
                <CheckBox x:Name="MatchCaseCheckBox" DockPanel.Dock="Right" Content="Match case" Margin="8,0" VerticalAlignment="Center" />
                <TextBox x:Name="FindTextBox" MinWidth="120" Margin="0,2" Padding="6,4" ToolTip="Text to find" KeyDown="OnFindTextBoxKeyDown" />
              </DockPanel>
              <DockPanel x:Name="ReplaceControlsPanel" LastChildFill="True" Visibility="Collapsed">
                <Button DockPanel.Dock="Right" Content="Replace All" Padding="8,2" MinHeight="24" Click="OnReplaceAllClick" />
                <Button DockPanel.Dock="Right" Content="Replace" Padding="8,2" MinHeight="24" Click="OnReplaceOneClick" />
                <TextBox x:Name="ReplaceTextBox" MinWidth="120" Margin="0,2" Padding="6,4" ToolTip="Replacement text" />
              </DockPanel>
            </StackPanel>
          </Border>

          <avalonEdit:TextEditor x:Name="SourceEditor"
                                 Grid.Row="2"
                                 FlowDirection="LeftToRight"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="14"
                                 ShowLineNumbers="True"
                                 SyntaxHighlighting="XML"
                                 HorizontalScrollBarVisibility="Hidden"
                                 VerticalScrollBarVisibility="Auto"
                                 WordWrap="True" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3"
                    Width="7"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#CBD5E1"
                    ShowsPreview="True"
                    AutomationProperties.Name="Resize Live Preview" />

      <Border Grid.Column="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="12,8" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="Live Preview" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
              <TextBlock x:Name="PreviewStateText" Text="Fit &#x00B7; Loading &#x00B7; Secure image mode" HorizontalAlignment="Right" Foreground="#475569" />
            </DockPanel>
          </Border>

          <Grid Grid.Row="1" Background="#F8FAFC">
            <wv2:WebView2CompositionControl
                x:Name="PreviewWebView"
                AllowExternalDrop="False"
                DefaultBackgroundColor="#FFF8FAFC"
                PreviewKeyDown="OnPreviewWebViewPreviewKeyDown"
                ZoomFactorChanged="OnPreviewWebViewZoomFactorChanged"
                LostKeyboardFocus="OnPreviewWebViewLostKeyboardFocus"
                SizeChanged="OnPreviewWebViewSizeChanged" />
            <Border x:Name="PreviewMessagePanel" Background="#F8FAFC" Padding="32">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <ProgressBar x:Name="PreviewLoadingIndicator" Width="220" Height="4" Margin="0,0,0,20" IsIndeterminate="True" />
                <TextBlock x:Name="PreviewMessageTitle" Text="Loading preview" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Foreground="#0F172A" />
                <TextBlock x:Name="PreviewMessageText" Margin="0,12,0,16" TextWrapping="Wrap" TextAlignment="Center" Foreground="#475569" />
                <TextBlock x:Name="PreviewRuntimeLink" Visibility="Collapsed" TextAlignment="Center">
                  <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/#download-section" RequestNavigate="OnRuntimeLinkNavigate">
                    Download the Evergreen WebView2 Runtime from Microsoft
                  </Hyperlink>
                </TextBlock>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </DockPanel>

    <Border x:Name="FileDropOverlay"
            Panel.ZIndex="1000"
            Margin="18"
            Padding="28"
            Background="#E60F172A"
            BorderBrush="#60A5FA"
            BorderThickness="3"
            CornerRadius="12"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Focusable="False"
            AutomationProperties.Name="Drop SVG or TXT to open"
            AutomationProperties.LiveSetting="Polite">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="620">
        <TextBlock Text="Drop SVG or TXT to open"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="White"
                   TextAlignment="Center" />
        <TextBlock x:Name="FileDropOverlayFileName"
                   Margin="0,10,0,0"
                   FontSize="16"
                   Foreground="#BFDBFE"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
