<Window x:Class="SvgLiveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding WindowTitle}"
        Icon="Assets/SvgLiveEditor.ico"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="560"
        AllowDrop="True"
        Background="#F8FAFC"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        Deactivated="OnWindowDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewDragEnter="OnWindowPreviewDragEnter"
        PreviewDragOver="OnWindowPreviewDragOver"
        PreviewDragLeave="OnWindowPreviewDragLeave"
        PreviewDrop="OnWindowDrop"
        QueryContinueDrag="OnWindowQueryContinueDrag">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="InspectorHelpButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Content" Value="i" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Help" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="IsTabStop" Value="True" />
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <EventSetter Event="GotKeyboardFocus"
                   Handler="OnInspectorHelpGotKeyboardFocus" />
      <EventSetter Event="LostKeyboardFocus"
                   Handler="OnInspectorHelpLostKeyboardFocus" />
    </Style>
    <Style x:Key="InspectorOptionalMessageStyle"
           TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LayerIconButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground"
              Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="IsTabStop" Value="True" />
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background"
                  Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush"
                  Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <ContextMenu x:Key="InspectorAuthoringContextMenu"
                 x:Shared="False">
      <MenuItem Header="_Add">
        <MenuItem Header="_Rectangle" Tag="Create:Rectangle" Click="OnCreateElementClick" />
        <MenuItem Header="_Circle" Tag="Create:Circle" Click="OnCreateElementClick" />
        <MenuItem Header="_Ellipse" Tag="Create:Ellipse" Click="OnCreateElementClick" />
        <MenuItem Header="_Line" Tag="Create:Line" Click="OnCreateElementClick" />
        <MenuItem Header="_Text" Tag="Create:Text" Click="OnCreateElementClick" />
        <MenuItem Header="_Empty Group" Tag="Create:Group" Click="OnCreateElementClick" />
      </MenuItem>
      <Separator />
      <MenuItem Header="_Duplicate"
                InputGestureText="Ctrl+D"
                Tag="Duplicate"
                Click="OnDuplicateElementClick"
                AutomationProperties.Name="Duplicate selected SVG element" />
      <MenuItem Header="_Delete"
                InputGestureText="Delete"
                Tag="Delete"
                Click="OnDeleteElementClick"
                AutomationProperties.Name="Delete selected SVG element" />
      <MenuItem Header="Move to SVG _Root (Front)"
                Tag="MoveToRoot"
                Click="OnMoveElementToRootClick"
                AutomationProperties.Name="Move selected element to front of SVG root" />
      <Separator />
      <MenuItem Header="Bring to Front" Tag="BringToFront" Click="OnArrangeClick" />
      <MenuItem Header="Bring Forward" Tag="BringForward" Click="OnArrangeClick" />
      <MenuItem Header="Send Backward" Tag="SendBackward" Click="OnArrangeClick" />
      <MenuItem Header="Send to Back" Tag="SendToBack" Click="OnArrangeClick" />
    </ContextMenu>
    <ContextMenu x:Key="AddElementContextMenu"
                 x:Shared="False"
                 Opened="OnAddElementContextMenuOpened">
      <MenuItem Header="_Rectangle" Tag="Create:Rectangle" Click="OnCreateElementClick" />
      <MenuItem Header="_Circle" Tag="Create:Circle" Click="OnCreateElementClick" />
      <MenuItem Header="_Ellipse" Tag="Create:Ellipse" Click="OnCreateElementClick" />
      <MenuItem Header="_Line" Tag="Create:Line" Click="OnCreateElementClick" />
      <MenuItem Header="_Text" Tag="Create:Text" Click="OnCreateElementClick" />
      <MenuItem Header="_Empty Group" Tag="Create:Group" Click="OnCreateElementClick" />
    </ContextMenu>
  </Window.Resources>

  <Grid>
    <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top" Background="White">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="OnNewClick" />
        <MenuItem Header="New from _Template..."
                  InputGestureText="Ctrl+Alt+N"
                  Click="OnNewFromTemplateClick"
                  AutomationProperties.Name="New from Template" />
        <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OnOpenClick" />
        <Separator />
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="OnSaveClick" />
        <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="OnSaveAsClick" />
        <Separator />
        <MenuItem x:Name="AutoSaveMenuItem"
                  Header="_Auto Save"
                  IsCheckable="True"
                  IsChecked="False"
                  Click="OnAutoSaveClick"
                  AutomationProperties.Name="Auto Save" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit" SubmenuOpened="OnEditMenuSubmenuOpened">
        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndoClick" />
        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedoClick" />
        <Separator />
        <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="OnFindClick" />
        <MenuItem Header="_Replace" InputGestureText="Ctrl+H" Click="OnReplaceClick" />
        <Separator />
        <MenuItem Header="_Duplicate Selected Element"
                  InputGestureText="Ctrl+D"
                  Tag="Duplicate"
                  Click="OnDuplicateElementClick"
                  AutomationProperties.Name="Duplicate selected SVG element" />
        <MenuItem Header="_Delete Selected Element"
                  InputGestureText="Delete"
                  Tag="Delete"
                  Click="OnDeleteElementClick"
                  AutomationProperties.Name="Delete selected SVG element" />
        <Separator />
        <MenuItem Header="Copy _Entire SVG Source"
                  InputGestureText="Ctrl+Alt+C"
                  Click="OnCopyEntireSourceClick"
                  AutomationProperties.Name="Copy Entire SVG Source" />
      </MenuItem>
      <MenuItem Header="_Arrange"
                SubmenuOpened="OnArrangeMenuSubmenuOpened">
        <MenuItem x:Name="BringToFrontMenuItem"
                  Header="Bring to _Front"
                  InputGestureText="Ctrl+Shift+]"
                  Tag="BringToFront"
                  Click="OnArrangeClick" />
        <MenuItem x:Name="BringForwardMenuItem"
                  Header="Bring _Forward"
                  InputGestureText="Ctrl+]"
                  Tag="BringForward"
                  Click="OnArrangeClick" />
        <MenuItem x:Name="SendBackwardMenuItem"
                  Header="Send _Backward"
                  InputGestureText="Ctrl+["
                  Tag="SendBackward"
                  Click="OnArrangeClick" />
        <MenuItem x:Name="SendToBackMenuItem"
                  Header="Send to _Back"
                  InputGestureText="Ctrl+Shift+["
                  Tag="SendToBack"
                  Click="OnArrangeClick" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="WordWrapMenuItem"
                  Header="_Word Wrap"
                  InputGestureText="Alt+Z; Ctrl+Alt+W"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="OnWordWrapClick" />
        <Separator />
        <MenuItem x:Name="ReopenLastDocumentMenuItem"
                  Header="_Reopen last document on startup"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="OnReopenLastDocumentClick" />
      </MenuItem>
      <MenuItem Header="_Preview">
        <MenuItem Header="_Refresh" Click="OnRefreshPreviewClick" />
        <Separator />
        <MenuItem Header="_Copy Preview as PNG"
                  InputGestureText="Ctrl+Shift+C"
                  IsEnabled="{Binding CanCopyPreviewAsPng}"
                  Click="OnCopyPreviewAsPngClick"
                  AutomationProperties.Name="Copy Preview as PNG" />
        <Separator />
        <MenuItem Header="Zoom _In" Click="OnZoomInClick" />
        <MenuItem Header="Zoom _Out" Click="OnZoomOutClick" />
        <MenuItem Header="_Reset Zoom" Click="OnResetZoomClick" />
        <MenuItem Header="_Fit to Preview" Click="OnFitPreviewClick" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About SvgLiveEditor" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top" Background="#F1F5F9" IsLocked="True">
      <ToolBar Background="Transparent" BorderThickness="0">
        <Button Content="New" ToolTip="New (Ctrl+N)" Click="OnNewClick" />
        <Button Content="Templates"
                ToolTip="New from Template (Ctrl+Alt+N)"
                Click="OnNewFromTemplateClick"
                AutomationProperties.Name="New from Template" />
        <Button Content="Open" ToolTip="Open SVG or TXT (Ctrl+O)" Click="OnOpenClick" />
        <Button Content="Save" ToolTip="Save (Ctrl+S)" Click="OnSaveClick" />
        <Separator />
        <Button Content="Refresh Preview" ToolTip="Validate and refresh now" Click="OnRefreshPreviewClick" />
        <Separator />
        <Button Content="Copy Image"
                ToolTip="Copy the full valid SVG artwork as a transparent PNG (Ctrl+Shift+C)"
                AutomationProperties.Name="Copy Preview as PNG"
                IsEnabled="{Binding CanCopyPreviewAsPng}"
                Click="OnCopyPreviewAsPngClick" />
        <Button x:Name="DragImageButton"
                ToolTip="Drag the rendered PNG to another application"
                AutomationProperties.Name="Drag Image"
                IsEnabled="{Binding CanCopyPreviewAsPng}"
                PreviewMouseLeftButtonDown="OnDragImagePreviewMouseLeftButtonDown"
                PreviewMouseMove="OnDragImagePreviewMouseMove"
                PreviewMouseLeftButtonUp="OnDragImagePreviewMouseLeftButtonUp"
                LostMouseCapture="OnDragImageLostMouseCapture">
          <StackPanel Orientation="Horizontal">
            <Path Width="14"
                  Height="14"
                  Margin="0,0,5,0"
                  Stretch="Uniform"
                  Fill="#334155"
                  Data="M3,1 L11,1 L11,4 L9,4 L9,3 L5,3 L5,9 L9,9 L9,8 L11,8 L11,11 L3,11 Z M8,5 L12,5 L12,3 L15,6 L12,9 L12,7 L8,7 Z" />
            <TextBlock Text="Drag Image" />
          </StackPanel>
        </Button>
        <ToggleButton x:Name="SelectModeButton"
                      Content="Select"
                      IsChecked="True"
                      ToolTip="Select and move supported SVG elements (V)"
                      AutomationProperties.Name="Select preview tool"
                      Click="OnSelectModeClick" />
        <ToggleButton x:Name="PanModeButton"
                      Content="Pan"
                      ToolTip="Pan overflowing preview with left drag (H toggles, Escape exits)"
                      AutomationProperties.Name="Pan preview mode"
                      Click="OnPanModeClick" />
        <Separator />
        <Button Content="Zoom In" ToolTip="Increase artwork zoom" Click="OnZoomInClick" />
        <Button Content="Zoom Out" ToolTip="Decrease artwork zoom" Click="OnZoomOutClick" />
        <Button Content="Reset Zoom" ToolTip="Show artwork at 100%" Click="OnResetZoomClick" />
        <Button Content="Fit" ToolTip="Fit SVG to the preview area" Click="OnFitPreviewClick" />
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom" Background="#E2E8F0" MinHeight="28">
      <StatusBarItem>
        <TextBlock Text="{Binding CurrentFileName}" FontWeight="SemiBold" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding SaveStatus}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding OperationStatus}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding OperationStatus}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock>
          <Run Text="Ln " /><Run Text="{Binding LineNumber, Mode=OneWay}" /><Run Text=", Col " /><Run Text="{Binding ColumnNumber, Mode=OneWay}" />
        </TextBlock>
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalContentAlignment="Stretch">
        <TextBlock Text="{Binding ValidationStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValidationStatus}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#B91C1C" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSvgValid}" Value="True">
                  <Setter Property="Foreground" Value="#047857" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" MinWidth="200" MaxWidth="460" />
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <Border x:Name="InspectorWorkspace"
              Grid.Column="0"
              Background="White"
              BorderBrush="#CBD5E1"
              BorderThickness="1"
              CornerRadius="6"
              AutomationProperties.Name="Layers and Structure inspector workspace">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="150" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="180" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  Padding="12,8"
                  Background="#F1F5F9"
                  BorderBrush="#CBD5E1"
                  BorderThickness="0,0,0,1">
            <DockPanel>
              <Button x:Name="AddElementButton"
                      DockPanel.Dock="Right"
                      Width="28"
                      Height="26"
                      Margin="8,0,0,0"
                      Padding="0"
                      Content="+"
                      FontSize="18"
                      FontWeight="SemiBold"
                      IsEnabled="False"
                      Click="OnAddElementClick"
                      ContextMenu="{StaticResource AddElementContextMenu}"
                      ToolTip="Add SVG element"
                      AutomationProperties.Name="Add SVG element"
                      AutomationProperties.HelpText="Add Rectangle, Circle, Ellipse, Line, Text, or Group to the selected safe layer context." />
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding Inspector.StateMessage}"
                         Margin="8,0,0,0"
                         HorizontalAlignment="Right"
                         Foreground="#64748B"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Inspector.StateMessage}" />
              <TextBlock Text="Layers &amp; Structure"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
            </DockPanel>
          </Border>

          <Grid Grid.Row="1">
            <TabControl x:Name="InspectorModeTabs"
                        BorderThickness="0"
                        Padding="0"
                        AutomationProperties.Name="Layers and SVG structure">
              <TabItem x:Name="LayersTab"
                       Header="Layers"
                       AutomationProperties.Name="Layers">
                <Grid>
                  <TreeView x:Name="LayersTree"
                            ItemsSource="{Binding Inspector.LayerRoots}"
                            SelectedItemChanged="OnLayersTreeSelectionChanged"
                            PreviewMouseLeftButtonDown="OnLayersTreePreviewMouseLeftButtonDown"
                            PreviewMouseRightButtonDown="OnInspectorTreePreviewMouseRightButtonDown"
                            PreviewMouseMove="OnLayersTreePreviewMouseMove"
                            PreviewKeyDown="OnLayersTreePreviewKeyDown"
                            PreviewKeyUp="OnInspectorTreePreviewKeyUp"
                            LostKeyboardFocus="OnInspectorTreeLostKeyboardFocus"
                            ContextMenuOpening="OnInspectorArrangeContextMenuOpening"
                            AllowDrop="True"
                            DragOver="OnLayersTreeDragOver"
                            DragLeave="OnLayersTreeDragLeave"
                            Drop="OnLayersTreeDrop"
                            BorderThickness="0"
                            Padding="4"
                            ContextMenu="{StaticResource InspectorAuthoringContextMenu}"
                            AutomationProperties.Name="Layers, frontmost first"
                            AutomationProperties.HelpText="Items higher in this list paint in front. Drop near a row edge to reorder, or in the center of a group to move inside it.">
                    <TreeView.ItemContainerStyle>
                      <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding RowHelp}" />
                      </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                      <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid MinHeight="27"
                              ToolTip="{Binding RowHelp}">
                          <Border Height="2"
                                  VerticalAlignment="Top"
                                  Background="#2563EB"
                                  Visibility="{Binding IsDropBefore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Border Height="2"
                                  VerticalAlignment="Bottom"
                                  Background="#2563EB"
                                  Visibility="{Binding IsDropAfter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Border Margin="1"
                                  Background="#142563EB"
                                  BorderBrush="#2563EB"
                                  BorderThickness="2"
                                  CornerRadius="3"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding IsDropInside, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="24" />
                              <ColumnDefinition Width="24" />
                              <ColumnDefinition Width="24" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource LayerIconButtonStyle}"
                                    IsEnabled="{Binding CanToggleVisibility}"
                                    Tag="{Binding}"
                                    Click="OnLayerVisibilityClick"
                                    ToolTip="{Binding VisibilityHelp}"
                                    AutomationProperties.Name="{Binding VisibilityAutomationName}"
                                    AutomationProperties.HelpText="{Binding VisibilityHelp}">
                              <Viewbox Width="16"
                                       Height="16"
                                       Stretch="Uniform"
                                       IsHitTestVisible="False">
                                <Grid Width="16" Height="16">
                                  <Path Data="M1,8 C3.2,4.4 5.5,2.75 8,2.75 C10.5,2.75 12.8,4.4 15,8 C12.8,11.6 10.5,13.25 8,13.25 C5.5,13.25 3.2,11.6 1,8 Z"
                                        Fill="Transparent"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                        StrokeThickness="1.5"
                                        StrokeLineJoin="Round" />
                                  <Ellipse Width="4"
                                           Height="4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                  <Path Data="M2,2 L14,14"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                        StrokeThickness="2"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round">
                                    <Path.Style>
                                      <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Path.Style>
                                  </Path>
                                </Grid>
                              </Viewbox>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource LayerIconButtonStyle}"
                                    IsEnabled="{Binding CanToggleLock}"
                                    Tag="{Binding}"
                                    Click="OnLayerLockClick"
                                    ToolTip="{Binding LockHelp}"
                                    AutomationProperties.Name="{Binding LockAutomationName}"
                                    AutomationProperties.HelpText="{Binding LockHelp}">
                              <Viewbox Width="16"
                                       Height="16"
                                       Stretch="Uniform"
                                       IsHitTestVisible="False">
                                <Grid Width="16" Height="16">
                                  <Path Data="M3,7.5 H13 V15 H3 Z"
                                        Fill="Transparent"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                        StrokeThickness="1.5"
                                        StrokeLineJoin="Round" />
                                  <Path Data="M4.5,7.5 V5.25 C4.5,1.75 11.5,1.75 11.5,5.25 V7.5"
                                        Fill="Transparent"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                        StrokeThickness="1.5"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round">
                                    <Path.Style>
                                      <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsEffectivelyLocked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Path.Style>
                                  </Path>
                                  <Path Data="M5,7.5 V5.25 C5,2.25 11.5,2.25 11.5,5.25"
                                        Fill="Transparent"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                        StrokeThickness="1.5"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round">
                                    <Path.Style>
                                      <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsEffectivelyLocked}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Path.Style>
                                  </Path>
                                </Grid>
                              </Viewbox>
                            </Button>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TypeIcon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       AutomationProperties.Name="{Binding TypeLabel}" />
                            <TextBlock Grid.Column="3"
                                       Margin="3,0,4,0"
                                       Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="#0F172A" />
                            <Border Grid.Column="4"
                                    Margin="2,3,3,3"
                                    Padding="4,0"
                                    Background="#F1F5F9"
                                    CornerRadius="3"
                                    Visibility="{Binding IsInspectionOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <TextBlock Text="Inspect"
                                         FontSize="10"
                                         Foreground="#64748B" />
                            </Border>
                          </Grid>
                        </Grid>
                      </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>

                  <Border Background="White" Padding="18">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Inspector.HasIndex}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Inspector.StateTitle}"
                                 FontWeight="SemiBold"
                                 TextAlignment="Center"
                                 Foreground="#334155" />
                      <TextBlock Text="{Binding Inspector.StateMessage}"
                                 Margin="0,6,0,0"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Foreground="#64748B" />
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem x:Name="StructureTab"
                       Header="Structure"
                       AutomationProperties.Name="SVG XML Structure">
                <Grid>
            <TreeView x:Name="InspectorTree"
                      ItemsSource="{Binding Inspector.Roots}"
                      SelectedItemChanged="OnInspectorTreeSelectionChanged"
                      PreviewMouseLeftButtonDown="OnInspectorTreePreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="OnInspectorTreePreviewMouseRightButtonDown"
                      PreviewKeyDown="OnInspectorTreePreviewKeyDown"
                      PreviewKeyUp="OnInspectorTreePreviewKeyUp"
                      LostKeyboardFocus="OnInspectorTreeLostKeyboardFocus"
                      ContextMenuOpening="OnInspectorArrangeContextMenuOpening"
                      BorderThickness="0"
                      Padding="4"
                      ContextMenu="{StaticResource InspectorAuthoringContextMenu}"
                      AutomationProperties.Name="SVG element tree">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                  <Setter Property="Padding" Value="2" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Label}" Foreground="#0F172A" />
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <Border Background="White" Padding="18">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Inspector.HasIndex}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Inspector.StateTitle}"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Foreground="#334155" />
                <TextBlock Text="{Binding Inspector.StateMessage}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#64748B" />
              </StackPanel>
            </Border>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>

          <GridSplitter Grid.Row="2"
                        Height="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#CBD5E1"
                        ShowsPreview="True"
                        AutomationProperties.Name="Resize inspector sections" />

          <Border Grid.Row="3"
                  Padding="12,8"
                  Background="#F8FAFC"
                  BorderBrush="#CBD5E1"
                  BorderThickness="0,1,0,1">
            <DockPanel>
              <TextBlock Text="Properties"
                         FontWeight="SemiBold"
                         Foreground="#0F172A" />
              <TextBlock Text="{Binding Inspector.SelectedElementSummary}"
                         Margin="8,0,0,0"
                         HorizontalAlignment="Right"
                         Foreground="#64748B"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Inspector.SelectedElementSummary}" />
            </DockPanel>
          </Border>

          <Grid x:Name="InspectorPropertiesPanel" Grid.Row="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Margin="8,8,8,0"
                    Padding="8,6"
                    Background="#FFF7ED"
                    BorderBrush="#FDBA74"
                    BorderThickness="1"
                    CornerRadius="4">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Inspector.SelectionAdvisory}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding Inspector.SelectionAdvisory}"
                         TextWrapping="Wrap"
                         Foreground="#9A3412"
                         AutomationProperties.Name="{Binding Inspector.SelectionAdvisory}" />
            </Border>
            <Border Grid.Row="1"
                    Margin="8,8,8,0"
                    Padding="8,5"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding Inspector.HasLayerPosition, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="{Binding Inspector.LayerPosition.BoundaryExplanation}"
                    AutomationProperties.Name="Current SVG layer position"
                    AutomationProperties.HelpText="{Binding Inspector.LayerPosition.BoundaryExplanation}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Inspector.LayerPosition.DisplayText}"
                           FontWeight="SemiBold"
                           Foreground="#1E3A8A"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Foreground="#475569"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip="{Binding Inspector.LayerPosition.ParentLabel}">
                  <Run Text="Parent: " />
                  <Run Text="{Binding Inspector.LayerPosition.ParentLabel}" />
                </TextBlock>
                <Button Grid.Column="3"
                        Style="{StaticResource InspectorHelpButtonStyle}"
                        AutomationProperties.Name="Layer ordering information"
                        AutomationProperties.HelpText="{Binding Inspector.LayerPosition.BoundaryExplanation}">
                  <Button.ToolTip>
                    <ToolTip Content="{Binding Inspector.LayerPosition.BoundaryExplanation}" />
                  </Button.ToolTip>
                </Button>
              </Grid>
            </Border>
            <Border Grid.Row="2"
                    Margin="8,8,8,0"
                    Padding="8,6"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding Inspector.HasOpacityControl, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="{Binding Inspector.Opacity.UnavailableReason}">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <StackPanel Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <TextBlock Text="Opacity"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               VerticalAlignment="Center"
                               ToolTip="Controls this element's own global opacity. Ancestor opacity may reduce the effective result."
                               AutomationProperties.HelpText="Controls this element's own global opacity from 0% to 100%." />
                    <Button Style="{StaticResource InspectorHelpButtonStyle}"
                            AutomationProperties.Name="Opacity help"
                            AutomationProperties.HelpText="Controls the whole element's opacity from 0% to 100%. Ancestor opacity may reduce the effective result.">
                      <Button.ToolTip>
                        <ToolTip Content="Controls the whole element's opacity from 0% to 100%. Ancestor opacity may reduce the effective result." />
                      </Button.ToolTip>
                    </Button>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBox Width="52"
                             MinHeight="24"
                             Padding="4,2"
                             HorizontalAlignment="Right"
                             TextAlignment="Right"
                             Text="{Binding Inspector.Opacity.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Inspector.Opacity.IsEnabled}"
                             Tag="{Binding Inspector.Opacity}"
                             LostKeyboardFocus="OnOpacityTextLostKeyboardFocus"
                             KeyDown="OnOpacityTextKeyDown"
                             AutomationProperties.Name="Opacity percentage"
                             AutomationProperties.HelpText="The selected element's own global opacity from 0% to 100%." />
                    <TextBlock Margin="4,4,0,0" Text="%" />
                  </StackPanel>
                </DockPanel>
                <Slider x:Name="OpacitySlider"
                        Margin="0,4,0,0"
                        MinHeight="20"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="False"
                        Value="{Binding Inspector.Opacity.Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding Inspector.Opacity.IsEnabled}"
                        Tag="{Binding Inspector.Opacity}"
                        PreviewMouseLeftButtonDown="OnOpacitySliderPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="OnOpacitySliderPreviewMouseLeftButtonUp"
                        LostKeyboardFocus="OnOpacitySliderLostKeyboardFocus"
                        PreviewKeyDown="OnOpacitySliderPreviewKeyDown"
                        PreviewKeyUp="OnOpacitySliderPreviewKeyUp"
                        ToolTip="Element opacity from 0% to 100%; committed once per completed gesture"
                        AutomationProperties.Name="Element opacity"
                        AutomationProperties.HelpText="The selected element's own global opacity; slider changes commit once per gesture." />
                <TextBlock Text="{Binding Inspector.Opacity.UnavailableReason}"
                           Style="{StaticResource InspectorOptionalMessageStyle}"
                           Foreground="#B91C1C" />
                <TextBlock Text="{Binding Inspector.Opacity.Advisory}"
                           Style="{StaticResource InspectorOptionalMessageStyle}"
                           Foreground="#92400E" />
                <TextBlock Text="{Binding Inspector.Opacity.ErrorMessage}"
                           Style="{StaticResource InspectorOptionalMessageStyle}"
                           Foreground="#B91C1C" />
              </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Grid.Row="3"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
              <ItemsControl ItemsSource="{Binding Inspector.Properties}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="3,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="100" />
                          <ColumnDefinition Width="*" MinWidth="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0"
                                     Margin="0,5,0,0"
                                     Text="{Binding Name}"
                                     Foreground="#334155"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding HelpText}"
                                     AutomationProperties.Name="{Binding Name}"
                                     AutomationProperties.HelpText="{Binding HelpText}" />
                          <Button Grid.Column="1"
                                  Style="{StaticResource InspectorHelpButtonStyle}"
                                  AutomationProperties.Name="{Binding Name, StringFormat={}{0} property help}"
                                  AutomationProperties.HelpText="{Binding HelpText}">
                            <Button.ToolTip>
                              <ToolTip Content="{Binding HelpText}" />
                            </Button.ToolTip>
                          </Button>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1">
                          <TextBox MinHeight="28"
                                   MinWidth="0"
                                   Padding="5,3"
                                   HorizontalAlignment="Stretch"
                                   ClipToBounds="True"
                                   Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   IsReadOnly="{Binding IsReadOnly}"
                                   Tag="{Binding}"
                                   ToolTip="{Binding HelpText}"
                                   LostKeyboardFocus="OnInspectorPropertyLostKeyboardFocus"
                                   KeyDown="OnInspectorPropertyKeyDown"
                                   AutomationProperties.Name="{Binding Name}"
                                   AutomationProperties.HelpText="{Binding HelpText}">
                            <TextBox.Style>
                              <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasAllowedValues}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding HasSuggestedValues}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBox.Style>
                          </TextBox>
                          <ComboBox MinHeight="28"
                                    MinWidth="0"
                                    Padding="5,3"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    MaxDropDownHeight="320"
                                    ItemsSource="{Binding AllowedValues}"
                                    SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Tag="{Binding}"
                                    ToolTip="{Binding HelpText}"
                                    LostKeyboardFocus="OnInspectorPropertyLostKeyboardFocus"
                                    KeyDown="OnInspectorPropertyKeyDown"
                                    AutomationProperties.Name="{Binding Name}"
                                    AutomationProperties.HelpText="{Binding HelpText}">
                            <ComboBox.Style>
                              <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasAllowedValues}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </ComboBox.Style>
                          </ComboBox>
                          <ComboBox MinHeight="28"
                                    MinWidth="0"
                                    Padding="5,3"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    MaxDropDownHeight="320"
                                    ClipToBounds="True"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    StaysOpenOnEdit="True"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ItemsSource="{Binding SuggestedValues}"
                                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Tag="{Binding}"
                                    ToolTip="{Binding SerializedValue}"
                                    SelectionChanged="OnInspectorSuggestedPropertySelectionChanged"
                                    LostKeyboardFocus="OnInspectorPropertyLostKeyboardFocus"
                                    KeyDown="OnInspectorPropertyKeyDown"
                                    AutomationProperties.Name="{Binding Name}"
                                    AutomationProperties.HelpText="{Binding HelpText}">
                            <ComboBox.Style>
                              <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasSuggestedValues}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </ComboBox.Style>
                          </ComboBox>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,3,0,0"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="#B91C1C" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border Grid.RowSpan="4" Background="White" Padding="18">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Inspector.HasSelection}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="Select an SVG element to inspect its supported attributes."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="#64748B" />
            </Border>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="7"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#CBD5E1"
                    ShowsPreview="True"
                    AutomationProperties.Name="Resize Layers and Structure inspector" />

      <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="12,8" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="Source" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
              <TextBlock Text="SVG / XML" HorizontalAlignment="Right" Foreground="#64748B" />
            </DockPanel>
          </Border>

          <Border x:Name="FindReplacePanel" Grid.Row="1" Visibility="Collapsed" Padding="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Close" Padding="8,2" MinHeight="24" Click="OnCloseFindClick" />
                <Button DockPanel.Dock="Right" Content="Next" Padding="8,2" MinHeight="24" Click="OnFindNextClick" />
                <CheckBox x:Name="MatchCaseCheckBox" DockPanel.Dock="Right" Content="Match case" Margin="8,0" VerticalAlignment="Center" />
                <TextBox x:Name="FindTextBox" MinWidth="120" Margin="0,2" Padding="6,4" ToolTip="Text to find" KeyDown="OnFindTextBoxKeyDown" />
              </DockPanel>
              <DockPanel x:Name="ReplaceControlsPanel" LastChildFill="True" Visibility="Collapsed">
                <Button DockPanel.Dock="Right" Content="Replace All" Padding="8,2" MinHeight="24" Click="OnReplaceAllClick" />
                <Button DockPanel.Dock="Right" Content="Replace" Padding="8,2" MinHeight="24" Click="OnReplaceOneClick" />
                <TextBox x:Name="ReplaceTextBox" MinWidth="120" Margin="0,2" Padding="6,4" ToolTip="Replacement text" />
              </DockPanel>
            </StackPanel>
          </Border>

          <avalonEdit:TextEditor x:Name="SourceEditor"
                                 Grid.Row="2"
                                 FlowDirection="LeftToRight"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="14"
                                 ShowLineNumbers="True"
                                 SyntaxHighlighting="XML"
                                 HorizontalScrollBarVisibility="Hidden"
                                 VerticalScrollBarVisibility="Auto"
                                 WordWrap="True" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3"
                    Width="7"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#CBD5E1"
                    ShowsPreview="True"
                    AutomationProperties.Name="Resize Live Preview" />

      <Border Grid.Column="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="12,8" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="Live Preview" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
              <TextBlock x:Name="PreviewStateText" Text="Fit &#x00B7; Loading &#x00B7; Secure image mode" HorizontalAlignment="Right" Foreground="#475569" />
            </DockPanel>
          </Border>

          <Grid Grid.Row="1" Background="#F8FAFC">
            <wv2:WebView2CompositionControl
                x:Name="PreviewWebView"
                AllowExternalDrop="False"
                DefaultBackgroundColor="#FFF8FAFC"
                PreviewKeyDown="OnPreviewWebViewPreviewKeyDown"
                ZoomFactorChanged="OnPreviewWebViewZoomFactorChanged"
                LostKeyboardFocus="OnPreviewWebViewLostKeyboardFocus"
                SizeChanged="OnPreviewWebViewSizeChanged" />
            <Border x:Name="PreviewMessagePanel" Background="#F8FAFC" Padding="32">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <ProgressBar x:Name="PreviewLoadingIndicator" Width="220" Height="4" Margin="0,0,0,20" IsIndeterminate="True" />
                <TextBlock x:Name="PreviewMessageTitle" Text="Loading preview" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Foreground="#0F172A" />
                <TextBlock x:Name="PreviewMessageText" Margin="0,12,0,16" TextWrapping="Wrap" TextAlignment="Center" Foreground="#475569" />
                <TextBlock x:Name="PreviewRuntimeLink" Visibility="Collapsed" TextAlignment="Center">
                  <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/#download-section" RequestNavigate="OnRuntimeLinkNavigate">
                    Download the Evergreen WebView2 Runtime from Microsoft
                  </Hyperlink>
                </TextBlock>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </DockPanel>

    <Border x:Name="FileDropOverlay"
            Panel.ZIndex="1000"
            Margin="18"
            Padding="28"
            Background="#E60F172A"
            BorderBrush="#60A5FA"
            BorderThickness="3"
            CornerRadius="12"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Focusable="False"
            AutomationProperties.Name="Drop SVG or TXT to open"
            AutomationProperties.LiveSetting="Polite">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="620">
        <TextBlock Text="Drop SVG or TXT to open"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="White"
                   TextAlignment="Center" />
        <TextBlock x:Name="FileDropOverlayFileName"
                   Margin="0,10,0,0"
                   FontSize="16"
                   Foreground="#BFDBFE"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
